---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { publishedTools } from '../data/tools';
---
<Base title="mimawsi — Made It, Might As Well Share It">
  <h1>mimawsi</h1>
  <p class="tag">Made It, Might As Well Share It</p>
  <p class="lede">
    A catalogue of small, single-file tools. Download one, double-click it, and it
    works — offline, forever, with nothing to install and nothing sent anywhere.
  </p>

  <p class="share">
    <a class="cta" href="/share">Share a tool</a>
    <span class="share-note">Made something? Put it here.</span>
  </p>

  <h2 class="section">Tools</h2>
  {publishedTools.map((tool) => <ToolCard tool={tool} />)}
</Base>

<style>
  .share {
    display: flex;
    align-items: center;
    gap: .8rem;
    flex-wrap: wrap;
    margin: 1.6rem 0 2rem;
  }

  /* An anchor rather than a button: it goes to a page, and a screen reader
     should say "link". Styled like a button because it is the one action the
     page invites. */
  .cta {
    display: inline-block;
    padding: .55rem 1.2rem;
    border-radius: .4rem;
    border: 1px solid currentColor;
    text-decoration: none;
    font-weight: 600;
  }

  .cta:hover, .cta:focus-visible {
    text-decoration: underline;
  }

  .share-note {
    color: var(--dim);
    font-size: .9rem;
  }

  .section {
    font-size: .8rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--dim); margin: 0 0 .8rem; font-weight: 600;
  }
</style>
