# Copy to terraform.tfvars and fill in. Never commit the real file.
account_id  = "000000000000"
site_bucket = "mimawsi-site-000000000000"

# Any high-entropy string; generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
operator_token = "replace-me"

google_client_id = "000000000000-example.apps.googleusercontent.com"

# Grok API Key
grok_api_key = "xai-..."

# Github PAT
github_dispatch_token = "github_pat_..."