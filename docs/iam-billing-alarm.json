{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageSpendAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:ListTagsForResource",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource"
      ],
      "Resource": "arn:aws:cloudwatch:*:418272759693:alarm:mimawsi-*"
    },
    {
      "Sid": "ManageTheAlarmTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:ListSubscriptionsByTopic",
        "sns:ListTagsForResource",
        "sns:TagResource",
        "sns:UntagResource"
      ],
      "Resource": "arn:aws:sns:*:418272759693:mimawsi-*"
    },
    {
      "Sid": "TagOurOwnLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource"
      ],
      "Resource": "arn:aws:logs:*:418272759693:log-group:/aws/lambda/mimawsi-*"
    }
  ]
}
