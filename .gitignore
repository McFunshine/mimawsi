# credentials — never commit
*.csv
*accessKeys*
*credentials*
.env
.env.*
!.env.example
*.pem
*.key

# build
node_modules/
dist/
node-compile-cache/
.astro/
__pycache__/
.venv/
venv/
.pytest_cache/

# local
.DS_Store
/tmp/

# phase-0 local store — the fake StoragePort's directory
.mimawsi-local/

# Tools published by a run of the tracer. The catalogue is genuinely files on
# disk in phase 0, so publishing writes here; global-teardown clears them, and
# this makes sure an interrupted run cannot leave one behind to be committed.
# The seed tool is committed and must survive.
packages/site/public/tools/*.html
!packages/site/public/tools/word-counter.html

# Working notes, handovers and review responses — useful locally, not product.
HANDOFF.md
notes/

# Terraform — state can contain secrets and must never be committed
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Terraform backend config carries the state bucket name
backend.hcl
!backend.hcl.example

# Test stores, if a run ever lands them here rather than in TMPDIR
/mimawsi-*/

# Playwright compiles specs into this next to the runner; 18 of them were
# committed to a public repo by a careless `git add -A`.
/playwright-transform-cache-*/
