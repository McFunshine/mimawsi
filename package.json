{
  "name": "mimawsi",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm --prefix tests test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "dev:site": "npm run dev --workspace @mimawsi/site",
    "dev:runner": "npm run dev --workspace @mimawsi/runner",
    "dev:api": "npm run dev --workspace @mimawsi/lambdas",
    "review": "npm run start --workspace @mimawsi/review-cli --"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "@types/node": "^22.10.0"
  }
}
