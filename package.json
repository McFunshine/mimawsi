{
  "name": "mimawsi",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm --prefix tests test",
    "test:e2e:ci": "CI=1 npm --prefix tests test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "dev:site": "npm run dev --workspace @mimawsi/site",
    "dev:runner": "npm run dev --workspace @mimawsi/runner",
    "dev:api": "npm run dev --workspace @mimawsi/lambdas",
    "review": "npm run start --workspace @mimawsi/review-cli --",
    "publish": "node scripts/publish.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "secrets": "gitleaks git --redact --config .gitleaks.toml --no-banner",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "lefthook": "^2.1.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.0.0"
  }
}
