{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontServicePrincipalReadOnly",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::SITE_BUCKET/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": [
            "arn:aws:cloudfront::ACCOUNT_ID:distribution/SITE_DISTRIBUTION_ID",
            "arn:aws:cloudfront::ACCOUNT_ID:distribution/RUNNER_DISTRIBUTION_ID"
          ]
        }
      }
    }
  ]
}