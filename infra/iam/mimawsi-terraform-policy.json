{
  "_comment": "Permissions the LOCAL identity needs to run Terraform for task-1.3 and the phases after it. This is the infrastructure identity, not the CI deploy role: RULE-17a keeps GitHub Actions away from DynamoDB and the published prefix, and nothing here is attached to that role. Scoped by mimawsi-* name prefix so a mistake cannot reach the other projects in this account. IAM is read-only on purpose: Terraform needs to read the OIDC role in order to adopt it, never to create roles. Substitute ACCOUNT_ID.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDbTablesForThisProjectOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": "arn:aws:dynamodb:*:ACCOUNT_ID:table/mimawsi-*"
    },
    {
      "Sid": "ListingTablesCannotBeScopedByName",
      "Effect": "Allow",
      "Action": ["dynamodb:ListTables"],
      "Resource": "*"
    },
    {
      "Sid": "LambdaForThisProjectOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionUrlConfig",
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig",
        "lambda:DeleteFunctionUrlConfig",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:ListVersionsByFunction",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:*:ACCOUNT_ID:function:mimawsi-*"
    },
    {
      "Sid": "ListingFunctionsCannotBeScopedByName",
      "Effect": "Allow",
      "Action": ["lambda:ListFunctions"],
      "Resource": "*"
    },
    {
      "Sid": "SesForNotifications",
      "Effect": "Allow",
      "Action": [
        "ses:ListIdentities",
        "ses:GetIdentityVerificationAttributes",
        "ses:GetIdentityDkimAttributes",
        "ses:VerifyDomainIdentity",
        "ses:VerifyDomainDkim",
        "ses:GetAccountSendingEnabled",
        "ses:DescribeConfigurationSet",
        "ses:CreateConfigurationSet",
        "ses:DeleteConfigurationSet"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadIamSoTerraformCanAdoptTheOidcRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRoles",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetOpenIDConnectProvider",
        "iam:ListOpenIDConnectProviders",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassRoleToLambdaOnly",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/mimawsi-*",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" }
      }
    }
  ]
}
