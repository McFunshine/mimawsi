{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadAndWriteTheSubmissionStoreOnly",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::mimawsi-pending-ACCOUNT_ID/*"
        },
        {
            "Sid": "ListBucketSoAMissingKeyIsA404",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::mimawsi-pending-ACCOUNT_ID"
        },
        {
            "Sid": "NoDeleteAndNoOtherBucket",
            "Effect": "Deny",
            "Action": [
                "s3:DeleteObject",
                "s3:DeleteObjectVersion"
            ],
            "Resource": "*"
        },
        {
            "Sid": "WriteItsOwnLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:*:ACCOUNT_ID:log-group:/aws/lambda/mimawsi-*:*"
        }
    ]
}
